{
  "description": "Heinlein project-local editorial advisories (never edit or publish manuscripts)",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/editorial.py\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/editorial.py\" stop",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
