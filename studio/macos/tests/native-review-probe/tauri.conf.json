{
  "productName": "Heinlein disposable review acceptance",
  "version": "0.0.0",
  "identifier": "me.thearcades.heinlein.synthetic-review",
  "build": {
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; object-src 'none'; frame-src 'none'; form-action 'none'; base-uri 'none'",
      "capabilities": [
        {
          "identifier": "review-native-fixture",
          "windows": [
            "main"
          ],
          "permissions": [
            "allow-review-definitions",
            "allow-list-reviews",
            "allow-get-review",
            "allow-choose-review-edit",
            "allow-reject-review-edit",
            "allow-approve-review-edit",
            "core:event:allow-emit"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "../../../src-tauri/icons/icon.png"
    ]
  }
}
