<!DOCTYPE html>
<html lang="{{ language }}"><head>
<meta charset="utf-8">
<title>{{ title }}</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&family=Lora:ital,wght@0,400;0,500;1,400;1,500&display=swap" rel="stylesheet">
<style>
{{ tokens_css | safe }}

/* -------- Page geometry --------
   Sheet = trim + bleed on every side. Text margins are measured from the
   trim, so body margins become (bleed + trim margin) on the printed sheet.
*/
@page {
  size: {{ sheet_w }}in {{ sheet_h }}in;
  margin: 0;
}
@page body-page {
  size: {{ sheet_w }}in {{ sheet_h }}in;
  margin: calc({{ bleed_in }}in + {{ margin_top }}) calc({{ bleed_in }}in + {{ margin_side }});
  @bottom-center {
    content: counter(page);
    font-family: 'JetBrains Mono', monospace;
    font-size: 9pt;
    color: var(--ink-muted);
    letter-spacing: 0.16em;
  }
}
@page major-section-blank {
  size: {{ sheet_w }}in {{ sheet_h }}in;
  margin: 0;
  @bottom-center { content: none; }
}

* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; }
body {
  font-family: 'Lora', Georgia, serif;
  color: var(--ink);
  background: var(--paper);
  font-size: 11pt;
  line-height: 1.55;
  -webkit-font-smoothing: antialiased;
}

/* -------- Page primitives -------- */
.page {
  page-break-after: always;
  break-after: page;
  width: {{ sheet_w }}in;
  height: {{ sheet_h }}in;
  overflow: hidden;
  position: relative;
}
.page:last-of-type { page-break-after: auto; }

/* Cover */
.cover {
  background: radial-gradient(circle at 8% 12%, rgba(255,138,0,0.14), transparent 38%),
              radial-gradient(circle at 92% 88%, rgba(232,199,119,0.12), transparent 38%),
              linear-gradient(135deg, #0a0a14 0%, #14142a 100%);
  color: var(--fg-dark);
  padding: calc({{ bleed_in }}in + {{ margin_top }}) calc({{ bleed_in }}in + {{ margin_side }});
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.cover-image {
  padding: 0;
  margin: 0;
  background: #000;
}
.cover-image img {
  width: {{ sheet_w }}in;
  height: {{ sheet_h }}in;
  object-fit: cover;
  display: block;
}
.cover-top {
  font-family: 'JetBrains Mono', monospace;
  font-size: 9pt;
  letter-spacing: 0.28em;
  color: var(--fg-dark-muted);
  text-transform: uppercase;
}
.cover-rule {
  height: 1px;
  background: linear-gradient(90deg, transparent, var(--neon-pink-d), var(--accent-d), transparent);
  margin: 16pt 0 0;
  width: 100%;
}
.cover-title {
  font-family: 'Inter', sans-serif;
  font-weight: 300;
  font-size: 40pt;
  letter-spacing: 0.04em;
  line-height: 1.05;
  color: #f6e7c8;
  margin: 0;
}
.cover-sub {
  font-family: 'Lora', serif;
  font-style: italic;
  font-size: 13pt;
  color: var(--gold-d);
  letter-spacing: 0.02em;
  margin: 12pt 0 0;
}
.cover-author {
  font-family: 'Inter', sans-serif;
  font-weight: 400;
  font-size: 13pt;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--fg-dark);
}
.cover-imprint {
  font-family: 'JetBrains Mono', monospace;
  font-size: 8pt;
  letter-spacing: 0.28em;
  color: var(--fg-dark-muted);
  text-transform: uppercase;
}
.cover-imprint strong { color: var(--gold-d); font-weight: 400; }

/* Colophon (interior) — mirrors the design system's CopyrightPage:
   muted mono eyebrow, italic Lora intro, hairline-divided copyright stack,
   and a foot row pairing the coin mark with the IC · YY · NNN issue tag. */
.colophon {
  background: var(--paper);
  color: var(--ink);
  padding: calc({{ bleed_in }}in + 0.85in) calc({{ bleed_in }}in + 0.7in);
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: {{ sheet_h }}in;
  font-family: 'Inter', sans-serif;
  font-size: 8.5pt;
  line-height: 1.55;
  color: var(--ink);
}
.colophon .top { display: block; }
.colophon .eyebrow {
  font-family: 'JetBrains Mono', monospace;
  font-size: 8pt;
  letter-spacing: 0.22em;
  color: var(--ink-muted);
  text-transform: uppercase;
  margin: 0 0 14pt;
}
.colophon .intro {
  font-family: 'Lora', serif;
  font-style: italic;
  font-size: 11pt;
  line-height: 1.55;
  color: var(--ink);
  margin: 0 0 18pt;
  max-width: 30em;
}
.colophon .divider {
  border: none;
  border-top: 0.5pt solid rgba(0, 0, 0, 0.15);
  margin: 0 0 14pt;
  width: 100%;
}
.colophon .rights p {
  margin: 0 0 6pt;
  max-width: 32em;
  color: var(--ink);
}
.colophon .rights p.muted { color: var(--ink-muted); }
.colophon .isbn {
  font-family: 'JetBrains Mono', monospace;
  font-size: 8pt;
  letter-spacing: 0.06em;
  line-height: 1.7;
  margin: 10pt 0 0;
  color: var(--ink);
}
.colophon .url {
  margin: 10pt 0 0;
  font-family: 'Inter', sans-serif;
  font-size: 8.5pt;
  color: var(--ink);
}
.colophon .foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-top: 0.5pt solid rgba(0, 0, 0, 0.15);
  padding-top: 12pt;
  color: var(--ink-muted);
}
.colophon .foot .mark { color: var(--ink-muted); display: inline-flex; align-items: center; }
.colophon .foot .tag {
  font-family: 'JetBrains Mono', monospace;
  font-size: 8pt;
  letter-spacing: 0.22em;
  text-transform: uppercase;
}

/* Title page */
.title-page {
  background: var(--paper);
  color: var(--ink);
  padding: calc({{ bleed_in }}in + 1.5in) calc({{ bleed_in }}in + {{ margin_side }});
  display: flex;
  flex-direction: column;
  justify-content: center;
  text-align: center;
  height: {{ sheet_h }}in;
}
.title-page .eyebrow {
  font-family: 'JetBrains Mono', monospace;
  font-size: 8.5pt;
  letter-spacing: 0.32em;
  color: var(--neon-pink);
  text-transform: uppercase;
  margin: 0 0 20pt;
}
.title-page h1 {
  font-family: 'Inter', sans-serif;
  font-weight: 300;
  font-size: 28pt;
  letter-spacing: 0.04em;
  line-height: 1.1;
  color: var(--ink);
  margin: 0 0 14pt;
}
.title-page .by {
  font-family: 'Lora', serif;
  font-style: italic;
  font-size: 12pt;
  color: var(--ink-muted);
  margin: 0 0 36pt;
}
.title-page .rule {
  height: 1px;
  width: 60pt;
  margin: 0 auto;
  background: linear-gradient(90deg, transparent, var(--neon-pink), var(--accent), transparent);
}

/* Dedication page */
.dedication {
  background: var(--paper);
  color: var(--ink);
  padding: calc({{ bleed_in }}in + 1.5in) calc({{ bleed_in }}in + {{ margin_side }});
  display: flex;
  flex-direction: column;
  justify-content: center;
  text-align: center;
  height: {{ sheet_h }}in;
}
.dedication p {
  font-family: 'Lora', serif;
  font-style: italic;
  font-size: 13pt;
  line-height: 1.6;
  color: var(--ink);
  margin: 0 0 0.7em;
}
.dedication p:last-child { margin-bottom: 0; }

/* Body */
.body-section {
  page: body-page;
  background: var(--paper);
  color: var(--ink);
}
.body-section p {
  font-family: 'Lora', Georgia, serif;
  font-size: 11pt;
  line-height: 1.6;
  margin: 0;
  text-indent: 1.2em;
  orphans: 2;
  widows: 2;
  hyphens: auto;
}
.body-section p + p { margin-top: 0; }
.body-section p.first { text-indent: 0; }
.body-section p.first::first-letter {
  font-family: 'Inter', sans-serif;
  font-weight: 400;
  font-size: 44pt;
  line-height: 0.9;
  float: left;
  padding: 6pt 8pt 0 0;
  color: var(--neon-pink);
}
.body-section hr {
  border: 0;
  height: 14pt;
  margin: 14pt 0;
  text-align: center;
  overflow: visible;
}
.body-section hr::after {
  content: "";
  display: block;
  width: 28%;
  height: 1.5pt;
  margin: 6pt auto 0;
  background: linear-gradient(90deg, transparent 0%, var(--ink) 7%, var(--ink) 93%, transparent 100%);
  border-radius: 50% 8% 50% 12%;
  transform: rotate(-0.18deg);
}
.body-section em { font-style: italic; }
.body-section .major-section-blank {
  page: major-section-blank;
  break-before: page;
  break-after: page;
  page-break-before: always;
  page-break-after: always;
  min-height: 1pt;
  color: transparent;
  font-size: 1pt;
  line-height: 1;
  margin: 0;
  padding: 0;
}
.body-section h2 {
  font-family: 'Inter', sans-serif;
  font-weight: 300;
  font-size: 22pt;
  letter-spacing: 0.04em;
  line-height: 1.15;
  color: var(--ink);
  text-align: center;
  margin: 0 0 24pt;
  padding-top: 1.4in;
  break-before: page;
  page-break-before: always;
}
.body-section h2:first-of-type { padding-top: 0; }
.body-section h2 + p { text-indent: 0; }
.body-section h2.twine-passage {
  color: transparent;
  font-size: 1pt;
  line-height: 1;
  margin: 0 0 1pt;
}
.twine-choices {
  break-inside: avoid;
  page-break-inside: avoid;
  margin: 24pt 0 0;
}
.twine-choices p { text-indent: 0; margin: 12pt 0; }
.twine-choice, .twine-back, .twine-restart {
  display: block;
  border: 1.5pt solid var(--ink);
  border-radius: 4pt;
  padding: 10pt 12pt;
  color: var(--ink);
  font-family: 'Inter', sans-serif;
  font-weight: 700;
  text-decoration: underline;
}
.twine-choice::before { content: "→  "; }
.twine-back { border-color: var(--ink-muted); color: var(--ink-muted); font-weight: 400; }
.twine-back::before { content: "←  "; }
.twine-restart { border-style: dashed; font-weight: 400; }

/* End-page colophon — dark backmatter signature with the coin mark up top,
   matching the design system's TitlePage header treatment. */
.end {
  background:
    radial-gradient(circle at 50% 18%, rgba(255,138,0,0.10), transparent 55%),
    radial-gradient(circle at 50% 88%, rgba(232,199,119,0.10), transparent 55%),
    var(--bg-deep);
  color: var(--fg-dark);
  padding: calc({{ bleed_in }}in + 1.3in) calc({{ bleed_in }}in + {{ margin_side }});
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  text-align: center;
  height: {{ sheet_h }}in;
}
.end .coin {
  display: inline-flex;
  margin: 0 0 18pt;
}
.end .eyebrow {
  font-family: 'JetBrains Mono', monospace;
  font-size: 8.5pt;
  letter-spacing: 0.32em;
  color: var(--fg-dark-muted);
  text-transform: uppercase;
  margin: 0 0 22pt;
}
.end .mark {
  font-family: 'Inter', sans-serif;
  font-weight: 300;
  font-size: 24pt;
  letter-spacing: 0.18em;
  color: #f6e7c8;
  margin: 0 0 10pt;
  text-shadow: 0 0 12pt rgba(232,199,119,0.45), 0 0 28pt rgba(255,138,0,0.30);
}
.end .mark-sub {
  font-family: 'Lora', serif;
  font-style: italic;
  font-size: 11pt;
  color: var(--gold-d);
  margin: 0 0 22pt;
}
.end .rule {
  height: 1px;
  width: 90pt;
  margin: 0 0 22pt;
  background: linear-gradient(90deg, transparent, var(--neon-pink-d), var(--accent-d), transparent);
}
.end .meta {
  font-family: 'JetBrains Mono', monospace;
  font-size: 8pt;
  letter-spacing: 0.28em;
  color: var(--fg-dark-muted);
  text-transform: uppercase;
  line-height: 1.9;
}
.end .meta .url { color: var(--fg-dark); letter-spacing: 0.22em; }
</style>
</head>
<body>

<!-- COVER -->
{%- if cover_uri %}
<section class="page cover-image">
  <img src="{{ cover_uri }}" alt="{{ title }} — cover" />
</section>
{%- else %}
<section class="page cover">
  <div>
    <div class="cover-top">{{ cover_eyebrow }}</div>
    <div class="cover-rule"></div>
  </div>
  <div>
    <h1 class="cover-title">{{ title_html | safe }}</h1>
    {%- if subtitle %}
    <p class="cover-sub">{{ subtitle }}</p>
    {%- endif %}
  </div>
  <div>
    <div class="cover-author">{{ author }}</div>
    <div style="margin-top: 22pt" class="cover-imprint"><strong>{{ imprint_name }}</strong> · {{ imprint_tagline }}</div>
  </div>
</section>
{%- endif %}

<!-- COLOPHON -->
<section class="page colophon">
  <div class="top">
    <p class="eyebrow">Colophon</p>
    <p class="intro">{{ colophon_intro | safe }}</p>
    <hr class="divider">
    <div class="rights">
      {%- for line in colophon_lines %}
      <p>{{ line }}</p>
      {%- endfor %}
      {%- if genre %}
      <p class="muted">Genre: {{ genre }}.</p>
      {%- endif %}
    </div>
    {%- if isbn_lines %}
    <div class="isbn">
      {%- for line in isbn_lines %}
      {{ line }}{% if not loop.last %}<br>{% endif %}
      {%- endfor %}
    </div>
    {%- endif %}
    <p class="url">{{ imprint_url }}</p>
  </div>
  <div class="foot">
    <span class="mark">
      <svg viewBox="0 0 130 100" width="28" height="22" aria-hidden="true" style="color: var(--ink-muted); display: block;">
        <rect x="70" y="10" width="22" height="80" rx="11" fill="none" stroke="currentColor" stroke-width="2.5"/>
        <rect x="80" y="22" width="2" height="56" rx="1" fill="currentColor"/>
        <path d="M 81,28 A 22,22 0 1,0 81,72 A 17,17 0 1,1 81,28 Z" fill="none" stroke="currentColor" stroke-width="2.8"/>
        <circle cx="79" cy="50" r="4" fill="currentColor"/>
      </svg>
    </span>
    <span class="tag">{{ issue_tag }}</span>
  </div>
</section>

<!-- TITLE PAGE -->
<section class="page title-page">
  {%- if subtitle %}
  <p class="eyebrow">{{ subtitle }}</p>
  {%- endif %}
  <h1>{{ title_html | safe }}</h1>
  <p class="by">by {{ author }}</p>
  <div class="rule"></div>
</section>

{%- if dedication_lines %}
<!-- DEDICATION -->
<section class="page dedication">
  <div>
  {%- for line in dedication_lines %}
    <p>{{ line }}</p>
  {%- endfor %}
  </div>
</section>
{%- endif %}

<!-- BODY -->
<section class="body-section">
{{ body_html | safe }}
</section>

<!-- END -->
<section class="page end">
  <span class="coin">
    <svg viewBox="0 0 130 100" width="104" height="80" aria-hidden="true" style="display: block; overflow: visible;">
      <defs>
        <linearGradient id="endCoinGrad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#ff8a00"/>
          <stop offset="100%" stop-color="#ff3cac"/>
        </linearGradient>
        <linearGradient id="endSlotGrad" x1="0%" y1="0%" x2="0%" y2="100%">
          <stop offset="0%" stop-color="#f5d98a"/>
          <stop offset="60%" stop-color="#e8c777"/>
          <stop offset="100%" stop-color="#c89a3e"/>
        </linearGradient>
      </defs>
      <rect x="70" y="10" width="22" height="80" rx="11" fill="#0a0a14" stroke="url(#endSlotGrad)" stroke-width="2.5"/>
      <rect x="80" y="22" width="2" height="56" rx="1" fill="#000"/>
      <rect x="80" y="22" width="1" height="56" rx="0.5" fill="#c89a3e" opacity="0.55"/>
      <path d="M 81,28 A 22,22 0 1,0 81,72 L 81,28 Z" fill="#000"/>
      <path d="M 81,28 A 22,22 0 1,0 81,72 A 17,17 0 1,1 81,28 Z" fill="none" stroke="url(#endCoinGrad)" stroke-width="2.8" opacity="0.95"/>
      <path d="M 79,41 A 9,9 0 1,0 79,59 Z" fill="#000"/>
      <path d="M 79,41 A 9,9 0 1,0 79,59 Z" fill="#ff8a00" opacity="0.78"/>
    </svg>
  </span>
  <div class="eyebrow">{{ imprint_blurb | replace('.', '') | upper }}</div>
  <div class="mark">{{ imprint_name | upper }}</div>
  <div class="mark-sub">{{ imprint_tagline_long }}</div>
  <div class="rule"></div>
  <div class="meta">
    fin · merci · à bientôt<br>
    <span class="url">{{ imprint_url }}</span>
  </div>
</section>

</body></html>
